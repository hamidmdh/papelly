<?xml version="1.0" encoding="utf-8"?>
<!--
  Papely Messaging — com.mdh.sms
  Repackaged from AOSP platform/packages/apps/Messaging (_upstream/, package com.android.messaging).
  Authorities and component names rewritten to com.mdh.sms to allow side-by-side install.
  Feature: unknown senders (not in contacts) -> no notification, Unknown folder.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <uses-permission android:name="android.permission.RECEIVE_MMS" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />

    <application
        android:label="Papely Messaging"
        android:icon="@drawable/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.Papely">

        <!-- Inbox + Unknown tabs -->
        <activity
            android:name=".ConversationListActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.APP_MESSAGING" />
            </intent-filter>
        </activity>

        <!-- Unknown folder -->
        <activity
            android:name=".UnknownListActivity"
            android:parentActivityName=".ConversationListActivity" />

        <!-- KLP+ delivery: only the Default SMS app receives this. -->
        <receiver
            android:name=".PapelySmsDeliverReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_DELIVER" />
            </intent-filter>
        </receiver>

        <!-- Required Default-SMS-app entry points (system shows app in Default SMS picker only
             if SENDTO smsto + RESPOND_VIA_MESSAGE are declared). Ported from upstream manifest. -->
        <activity android:name=".ComposeActivity">
            <intent-filter>
                <action android:name="android.intent.action.SENDTO" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="smsto" />
                <data android:scheme="sms" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
        </activity>

        <service
            android:name=".HeadlessSmsSendService"
            android:exported="true"
            android:permission="android.permission.SEND_RESPOND_VIA_MESSAGE">
            <intent-filter>
                <action android:name="android.intent.action.RESPOND_VIA_MESSAGE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="smsto" />
                <data android:scheme="sms" />
            </intent-filter>
        </service>
    </application>
</manifest>
